{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M-Theory",
  "version": "0.1.0",
  "identifier": "app.mtheory.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "M-Theory",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "M-Theory",
    "shortDescription": "Write songs, record vocals",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMjRBRTRFRTE0QUJCMDQKUldRRXUwcmhUcTRrd2MwL0xNUFc0K1Y1NHlHTHY1MUFYdHhKNWswVThYSmlTTk82Z2F6ekNOeEMK",
      "endpoints": [
        "https://github.com/darrylroxx/M-Theory-App/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}